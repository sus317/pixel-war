{
  "name": "pixel-war",
  "version": "1.0.0",
  "description": "Pixel War - pixel art wave survival game",
  "main": "main.js",
  "author": "sus317",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.example.pixelwar",
    "productName": "Pixel War",
    "files": ["index.html", "main.js"],
    "win": { "target": ["nsis", "portable"] },
    "mac": { "target": [{ "target": "dmg", "arch": ["x64", "arm64"] }], "category": "public.app-category.games" }
  }
}
